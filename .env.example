# papershelf 配置示例 —— 复制成 .env 或用容器环境变量注入（决策㉑：配置全走环境变量）
# ⚠️ 真实 .env 不要提交到版本库（含 LLM Key 与会话密钥）。

# ── 基础 ────────────────────────────────────────────────────────────────
# 会话/凭据签名密钥。**必须显式设置**（未设会打印告警并使用不安全的开发默认值）：
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
PAPERSHELF_SECRET=change-me-to-a-random-32-bytes
# 数据目录：SQLite + PDF + 抽取出的图片都在这里（容器里挂卷）
PAPERSHELF_DATA_DIR=./data
# 对外地址：激活链接、分享链接会用它拼绝对 URL；反代后填真实域名
PAPERSHELF_BASE_URL=http://localhost:8000

# ── 首次引导管理员（§7）────────────────────────────────────────────────
# 两者必须**成对**给出；只给邮箱不给密码会被拒绝（不允许静默默认密码）
# 事后也可以用 `papershelf create-admin <email>` 开号/重置
PAPERSHELF_ADMIN_EMAIL=you@your.edu.cn
PAPERSHELF_ADMIN_PASSWORD=at-least-8-chars

# ── LLM（决策⑧：服务端统一 Key，OpenAI 兼容协议）────────────────────────
PAPERSHELF_LLM_BASE_URL=https://api.siliconflow.cn/v1
PAPERSHELF_LLM_API_KEY=sk-...
PAPERSHELF_LLM_MODEL=deepseek-ai/DeepSeek-V3

# 成本护栏（待定项 5 的初值，按机器与预算调）
PAPERSHELF_MAX_CONCURRENCY=2          # 同时转换的文献数
PAPERSHELF_MAX_ATTEMPTS=3             # 单篇最大转换尝试次数，超限置 failed 待人工重试
# 常驻转换队列（保持默认即可）：启动时把上次被杀的 doing 复位，并轮询排空 queued。
# 关掉它 = 退回"只在请求线程里跑"，重启会丢掉排队中的文献（2026-09-12 事故的成因）。
PAPERSHELF_QUEUE=true
PAPERSHELF_QUEUE_INTERVAL=3           # 轮询间隔（秒）

# ── 注册与邮箱（决策⑭⑮）───────────────────────────────────────────────
# 注册白名单逗号分隔的**域名后缀**（含子域：`stu.pku.edu.cn` 命中 `edu.cn`）
# 默认 .edu.cn（高校）+ .ac.cn（科研院所，如 `cas.ac.cn`）
PAPERSHELF_EMAIL_DOMAIN_ALLOWLIST=edu.cn,ac.cn
# SMTP **可选**：配齐 HOST + FROM → 开放自助注册（邮件激活）；
# 未配 → 自助注册自动关闭，改由管理员在 /api/admin/users 开号（无需邮件服务也能用）
# PAPERSHELF_SMTP_HOST=smtp.example.com
# PAPERSHELF_SMTP_PORT=587
# PAPERSHELF_SMTP_USER=
# PAPERSHELF_SMTP_PASS=
# PAPERSHELF_SMTP_FROM=noreply@example.com
# PAPERSHELF_SMTP_TLS=true

# ── 分享（决策⑪）───────────────────────────────────────────────────────
# 默认有效期（小时）。**硬上限 24 小时**，填更大也只按 24 算；永久链接不支持。
# 创建分享时可在 1..24 之间按次覆盖。
PAPERSHELF_SHARE_HOURS=24
